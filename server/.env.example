# ===== 基础 =====
PORT=3000
STORE=prisma            # 云托管 + 云数据库：prisma（持久化）；本地快速验证：memory
DATABASE_URL=postgresql://user:pass@host:5432/island?schema=public
# 迁移：云端/生产用 npm run db:migrate:deploy；本地开发用 npm run db:migrate

# ===== 微信登录 =====
# 真机/体验版要真实登录时改 MOCK_AUTH=false 并填 WX_SECRET（微信公众平台获取）
MOCK_AUTH=true
WX_APPID=wxaaa7d6c05098f430
WX_SECRET=你的小程序AppSecret

# ===== AI =====
# 想接真实大模型：MOCK_AI=false 并填 LLM_*
MOCK_AI=true
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=你的密钥
# LLM_MODEL=doubao-1-5-pro-32k-250115
