# ===== 基础 =====
PORT=3000
STORE=memory            # memory（零依赖，开箱即跑）或 prisma（需 PostgreSQL）
# 用 Postgres 时填下面两项，并执行：npm run prisma:generate && npm run db:migrate
# DATABASE_URL=postgresql://user:pass@localhost:5432/island

# ===== 微信登录 =====
# 真机/体验版要真实登录时改 MOCK_AUTH=false 并填 WX_SECRET（微信公众平台获取）
MOCK_AUTH=true
WX_APPID=wxaaa7d6c05098f430
WX_SECRET=你的小程序AppSecret

# ===== AI =====
# 想接真实大模型：MOCK_AI=false 并填 LLM_*
MOCK_AI=true
# LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# LLM_API_KEY=你的密钥
# LLM_MODEL=doubao-1-5-pro-32k-250115
