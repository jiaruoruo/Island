.top {
  padding: 16rpx 0 24rpx;
}
.type-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.type-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
}
.type-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.opts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.opt {
  padding: 16rpx 28rpx;
  border-radius: 999rpx;
  background: #f6f4ff;
  color: #8a8597;
  font-size: 26rpx;
}
.opt.active {
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-weight: 600;
}
.report-card {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.score {
  font-size: 120rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  -webkit-background-clip: text;
  color: transparent;
}
.center-text {
  text-align: center;
}
.dim {
  width: 100%;
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
}
.dim-name {
  width: 90rpx;
  color: #8a8597;
  font-size: 26rpx;
}
.dim-bar {
  flex: 1;
  height: 20rpx;
  background: #f0ecff;
  border-radius: 999rpx;
  overflow: hidden;
}
.dim-fill {
  height: 100%;
  background: linear-gradient(90deg, #4fd1c5, #9b8cff);
  border-radius: 999rpx;
  transition: width 0.6s ease;
}
.dim-val {
  width: 60rpx;
  text-align: right;
  color: #5a4d9b;
  font-weight: 600;
}
