/* 视图切换 */
.seg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #8a8597;
  font-size: 28rpx;
  border: 2rpx solid #ece8f6;
}
.seg-item.active {
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-weight: 600;
  border: none;
}

/* 插画：两座小岛 + 中间海水 */
.hero {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 30rpx 24rpx 24rpx;
}
.isle {
  position: relative;
  z-index: 2;
  animation: isle-float 4s ease-in-out infinite;
}
.isle-right {
  animation-delay: 1s;
}
/* 每个小岛的场景容器 */
.scene {
  position: relative;
  width: 250rpx;
  height: 228rpx;
}
.octo-wrap {
  position: absolute;
  bottom: 28rpx;
  left: 52%;
}
.isle-right .octo-wrap {
  left: auto;
  right: 52%;
}
/* 望远镜：举到眼睛旁、朝对方眺望 */
.telescope {
  position: absolute;
  top: 24%;
  font-size: 46rpx;
  line-height: 1;
  z-index: 3;
}
.telescope-l {
  right: -18rpx;
  transform: rotate(-14deg);
}
.telescope-r {
  left: -18rpx;
  transform: scaleX(-1);
}
/* 小岛：沙丘（更扁平、原 🏝️ 沙色，表面粗糙像陆地） */
.island {
  position: absolute;
  left: 50%;
  bottom: 0;
  transform: translateX(-50%);
  width: 232rpx;
  height: 62rpx;
  background:
    radial-gradient(circle at 24% 34%, rgba(96, 152, 66, 0.6) 0 7rpx, transparent 8rpx),
    radial-gradient(circle at 46% 24%, rgba(84, 140, 58, 0.5) 0 5rpx, transparent 6rpx),
    radial-gradient(circle at 64% 40%, rgba(104, 160, 70, 0.55) 0 6rpx, transparent 7rpx),
    radial-gradient(circle at 80% 28%, rgba(120, 168, 78, 0.5) 0 5rpx, transparent 6rpx),
    radial-gradient(circle at 16% 58%, rgba(150, 110, 66, 0.5) 0 6rpx, transparent 7rpx),
    radial-gradient(circle at 70% 62%, rgba(140, 104, 60, 0.45) 0 5rpx, transparent 6rpx),
    linear-gradient(180deg, #e7d19a 0%, #d9bd82 60%, #c5a365 100%);
  border-radius: 62% 38% 0 0 / 100% 100% 0 0;
  box-shadow:
    inset 0 -12rpx 20rpx rgba(120, 90, 50, 0.18),
    inset 0 6rpx 10rpx rgba(255, 255, 255, 0.25);
  z-index: 1;
}
/* 椰子树（整体；右岛用 scaleX(-1) 镜像） */
.palm {
  position: absolute;
  left: 0;
  top: 0;
  width: 250rpx;
  height: 228rpx;
  z-index: 2;
}
.isle-right .palm {
  transform: scaleX(-1);
  transform-origin: center;
}
/* 椰子树干（细、稍低、自然弯曲） */
.trunk {
  position: absolute;
  left: 62rpx;
  bottom: 44rpx;
  width: 12rpx;
  height: 96rpx;
  background: linear-gradient(180deg, #bd8a52 0%, #8a5a36 100%);
  border-radius: 999rpx;
  transform: rotate(10deg);
  transform-origin: 50% 100%;
}
/* 椰子（小、多） */
.coconut {
  position: absolute;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 35% 30%, #a06a3a, #5d3b1f);
  z-index: 3;
}
.coconut.c1 { left: 74rpx; top: 82rpx; }
.coconut.c2 { left: 94rpx; top: 84rpx; }
.coconut.c3 { left: 84rpx; top: 74rpx; }
.coconut.c4 { left: 100rpx; top: 92rpx; }
.coconut.c5 { left: 76rpx; top: 94rpx; }
/* 树冠（扇形叶子） */
.crown {
  position: absolute;
  left: 84rpx;
  top: 89rpx;
  width: 0;
  height: 0;
  z-index: 2;
}
.frond {
  position: absolute;
  left: -10rpx;
  bottom: 0;
  width: 20rpx;
  height: 58rpx;
  background: linear-gradient(180deg, #4d8f3f, #7ec465);
  border-radius: 100% 0 100% 0;
  transform-origin: bottom center;
}
.frond.f1 { transform: rotate(-70deg); }
.frond.f2 { transform: rotate(-40deg); }
.frond.f3 { transform: rotate(-10deg); }
.frond.f4 { transform: rotate(20deg); }
.frond.f5 { transform: rotate(50deg); }
.frond.f6 { transform: rotate(75deg); }
/* 海水：铺满底部、贯穿两岛底部，与小岛相连 */
.sea {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 52rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #a9e9fb 0%, #4fc3e8 100%);
  z-index: 1;
}
/* 海面波浪线（白色弧线，轻微横向流动） */
.sea-line {
  position: absolute;
  left: 4%;
  right: 4%;
  height: 14rpx;
  border-top: 3rpx solid rgba(255, 255, 255, 0.6);
  border-radius: 50%;
  z-index: 2;
}
.sea-line.l1 {
  top: 8rpx;
  animation: line-drift 4s ease-in-out infinite;
}
.sea-line.l2 {
  top: 26rpx;
  opacity: 0.45;
  animation: line-drift 5s ease-in-out infinite reverse;
}
/* 水面波纹：扩散涟漪 */
.ripple {
  position: absolute;
  width: 40rpx;
  height: 12rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  opacity: 0;
  z-index: 2;
  animation: ripple-grow 3.4s ease-out infinite;
}
.ripple.r1 {
  left: 16%;
  top: 8rpx;
}
.ripple.r2 {
  left: 48%;
  top: 16rpx;
  animation-delay: 1.1s;
}
.ripple.r3 {
  left: 76%;
  top: 10rpx;
  animation-delay: 2.2s;
}
/* 小鱼：在海水中游动 */
.fish {
  position: absolute;
  font-size: 32rpx;
  line-height: 1;
  z-index: 3;
}
.fish1 {
  top: 8rpx;
  animation: swim1 7s ease-in-out infinite;
}
.fish2 {
  top: 24rpx;
  animation: swim2 9s ease-in-out infinite;
}
@keyframes ripple-grow {
  0% {
    transform: scale(0.3);
    opacity: 0.85;
  }
  70% {
    opacity: 0.25;
  }
  100% {
    transform: scale(2);
    opacity: 0;
  }
}
@keyframes line-drift {
  0%,
  100% {
    transform: translateX(0);
  }
  50% {
    transform: translateX(12rpx);
  }
}
@keyframes swim1 {
  0% {
    left: 38%;
    transform: scaleX(1);
  }
  48% {
    transform: scaleX(1);
  }
  50% {
    left: 60%;
    transform: scaleX(-1);
  }
  98% {
    transform: scaleX(-1);
  }
  100% {
    left: 38%;
    transform: scaleX(1);
  }
}
@keyframes swim2 {
  0% {
    left: 58%;
    transform: scaleX(-1);
  }
  48% {
    transform: scaleX(-1);
  }
  50% {
    left: 40%;
    transform: scaleX(1);
  }
  98% {
    transform: scaleX(1);
  }
  100% {
    left: 58%;
    transform: scaleX(-1);
  }
}
@keyframes isle-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

/* 搜索 */
.search-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border: 2rpx solid #2d2a3a;
  border-radius: 24rpx;
  padding: 12rpx 12rpx 12rpx 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(155, 140, 255, 0.12);
  margin-top: 23rpx; /* 向下移约 3mm */
  margin-bottom: 28rpx;
}
/* 放大镜 */
.search-icon {
  font-size: 30rpx;
  line-height: 1;
  flex-shrink: 0;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.search-btn {
  width: 104rpx;
  height: 76rpx;
  line-height: 72rpx;
  border: 2rpx solid #3b82f6;
  border-radius: 24rpx;
  background: #eaf3ff;
  color: #1d4ed8;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 0;
  flex-shrink: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

/* 用户卡片 */
.user-card,
.me-card {
  display: flex;
  align-items: center;
  border: 2rpx solid #2d2a3a;
}
.u-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.u-avatar.big {
  font-size: 48rpx;
}
.u-info {
  flex: 1;
  margin-left: 24rpx;
}
.u-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d2a3a;
}
.add-btn {
  width: 190rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
}

/* 我的名片：编辑资料按钮 */
.edit-btn {
  flex-shrink: 0;
  padding: 10rpx 26rpx;
  border: 2rpx solid #2d2a3a;
  border-radius: 24rpx;
  background: #fff;
  color: #2d2a3a;
  font-size: 26rpx;
  font-weight: 500;
  box-sizing: border-box;
}

/* 编辑资料弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d2a3a;
  text-align: center;
  margin-bottom: 28rpx;
}
.modal-input {
  background: #f5f3fb;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.modal-btn.cancel {
  background: #f0edf8;
  color: #8a8597;
}
.modal-btn.ok {
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
}

/* 四宫格（均匀 2×2） */
.grid {
  position: relative;
  display: flex;
  flex-wrap: wrap;
  padding: 0;
  border: 2rpx solid #2d2a3a;
}
/* 内部格线（浅于边框，不交叉） */
.gline {
  position: absolute;
  background: #d3cddf;
  z-index: 1;
}
.gline-h {
  left: 28rpx;
  right: 28rpx;
  top: 50%;
  height: 2rpx;
  transform: translateY(-50%);
}
.gline-vt {
  left: 50%;
  top: 28rpx;
  bottom: 50%;
  width: 2rpx;
  margin-bottom: 10rpx;
  transform: translateX(-50%);
}
.gline-vb {
  left: 50%;
  top: 50%;
  bottom: 28rpx;
  width: 2rpx;
  margin-top: 10rpx;
  transform: translateX(-50%);
}
.g {
  position: relative;
  width: 50%;
  box-sizing: border-box;
  padding: 32rpx;
  min-height: 210rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
}
/* 透明分享按钮覆盖整格，保证四格结构一致 */
.g-share {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  opacity: 0;
  z-index: 1;
  margin: 0;
  padding: 0;
  border-radius: 0;
}
.g-share::after {
  border: none;
}
.g-icon {
  font-size: 52rpx;
  margin-bottom: 14rpx;
}
/* 微信图标（绿底双气泡 + 眼睛） */
.wx-icon {
  position: relative;
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  background: #07c160;
}
.wx-icon::before,
.wx-icon::after {
  content: '';
  position: absolute;
  background:
    radial-gradient(circle at 34% 50%, #07c160 0 2rpx, transparent 3rpx),
    radial-gradient(circle at 66% 50%, #07c160 0 2rpx, transparent 3rpx),
    #fff;
}
.wx-icon::before {
  left: 8rpx;
  top: 9rpx;
  width: 24rpx;
  height: 20rpx;
  border-radius: 6rpx 6rpx 6rpx 2rpx;
}
.wx-icon::after {
  right: 8rpx;
  bottom: 9rpx;
  width: 22rpx;
  height: 18rpx;
  border-radius: 6rpx 6rpx 2rpx 6rpx;
}
.g-arrow {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  font-size: 40rpx;
  line-height: 1;
  color: #b9b3c6;
}
.g-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d2a3a;
}
.g-desc {
  font-size: 24rpx;
  color: #8a8597;
  margin-top: 6rpx;
}

/* 好友列表 */
.f-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

/* 好友申请 */
.req {
  display: flex;
  align-items: center;
}
.req-actions {
  display: flex;
  gap: 14rpx;
}
.mini-btn {
  width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 0;
  padding: 0;
}
.mini-btn.ok {
  background: linear-gradient(135deg, #4fd1c5, #2bb5a6);
  color: #fff;
}
.mini-btn.no {
  background: #f0edf8;
  color: #8a8597;
}
.center {
  text-align: center;
  padding: 80rpx 0;
}
