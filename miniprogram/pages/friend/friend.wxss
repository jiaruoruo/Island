/* 视图切换 */
.seg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #8a8597;
  font-size: 28rpx;
  border: 2rpx solid #ece8f6;
}
.seg-item.active {
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-weight: 600;
  border: none;
}

/* 插画 */
.hero {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 30rpx 0 36rpx;
}
.h-island {
  font-size: 56rpx;
}
.h-icon {
  font-size: 40rpx;
}

/* 搜索 */
.search-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 12rpx 12rpx 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(155, 140, 255, 0.12);
  margin-bottom: 28rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.search-btn {
  width: 52rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #f0ecff;
  color: #5a4d9b;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 0;
  flex-shrink: 0;
}

/* 用户卡片 */
.user-card,
.me-card {
  display: flex;
  align-items: center;
}
.u-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.u-avatar.big {
  font-size: 48rpx;
}
.u-info {
  flex: 1;
  margin-left: 24rpx;
}
.u-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d2a3a;
}
.add-btn {
  width: 190rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
}

/* 我的名片：编辑资料按钮 */
.edit-btn {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f0ecff;
  color: #5a4d9b;
  font-size: 26rpx;
  font-weight: 500;
}

/* 编辑资料弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d2a3a;
  text-align: center;
  margin-bottom: 28rpx;
}
.modal-input {
  background: #f5f3fb;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.modal-btn.cancel {
  background: #f0edf8;
  color: #8a8597;
}
.modal-btn.ok {
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
}

/* 四宫格（均匀 2×2） */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0;
}
.g {
  position: relative;
  width: 50%;
  box-sizing: border-box;
  padding: 32rpx;
  min-height: 210rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  border-bottom: 2rpx solid #f0edf8;
}
.g:nth-child(odd) {
  border-right: 2rpx solid #f0edf8;
}
.g:nth-child(n + 3) {
  border-bottom: none;
}
/* 透明分享按钮覆盖整格，保证四格结构一致 */
.g-share {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  opacity: 0;
  z-index: 1;
  margin: 0;
  padding: 0;
  border-radius: 0;
}
.g-share::after {
  border: none;
}
.g-icon {
  font-size: 52rpx;
  margin-bottom: 14rpx;
}
.g-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d2a3a;
}
.g-desc {
  font-size: 24rpx;
  color: #8a8597;
  margin-top: 6rpx;
}

/* 好友列表 */
.f-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

/* 好友申请 */
.req {
  display: flex;
  align-items: center;
}
.req-actions {
  display: flex;
  gap: 14rpx;
}
.mini-btn {
  width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 0;
  padding: 0;
}
.mini-btn.ok {
  background: linear-gradient(135deg, #4fd1c5, #2bb5a6);
  color: #fff;
}
.mini-btn.no {
  background: #f0edf8;
  color: #8a8597;
}
.center {
  text-align: center;
  padding: 80rpx 0;
}
