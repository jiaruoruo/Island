/* 视图切换 */
.seg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #8a8597;
  font-size: 28rpx;
  border: 2rpx solid #ece8f6;
}
.seg-item.active {
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-weight: 600;
  border: none;
}

/* 插画：两座小岛 + 中间海水 */
.hero {
  position: relative;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  padding: 30rpx 24rpx 36rpx;
}
.isle {
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 2;
  animation: isle-float 4s ease-in-out infinite;
}
.isle-right {
  animation-delay: 1s;
}
.h-island {
  font-size: 96rpx;
  line-height: 1;
  margin-top: -26rpx;
}
.h-icon {
  font-size: 40rpx;
}
/* 海水：水面与小岛底部齐平，小岛完全露出水面 */
.sea {
  position: relative;
  flex: 1;
  height: 70rpx;
  margin: 0 10rpx 0;
  border-radius: 22rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #8fe0f7 0%, #37b6e0 55%, #1f8fc4 100%);
  z-index: 1;
}
.wave {
  position: absolute;
  left: -60%;
  width: 220%;
  height: 240rpx;
  border-radius: 43%;
  background: rgba(255, 255, 255, 0.3);
  animation: wave-rotate 9s linear infinite;
}
.wave.w1 {
  top: 12rpx;
}
.wave.w2 {
  top: 24rpx;
  background: rgba(255, 255, 255, 0.18);
  animation-duration: 6.5s;
  animation-direction: reverse;
}
.wave.w3 {
  top: 36rpx;
  background: rgba(79, 209, 197, 0.38);
  animation-duration: 13s;
}
/* 水面波纹：扩散涟漪 */
.ripple {
  position: absolute;
  width: 56rpx;
  height: 18rpx;
  border-radius: 50%;
  border: 2rpx solid rgba(255, 255, 255, 0.65);
  opacity: 0;
  z-index: 2;
  animation: ripple-grow 3.6s ease-out infinite;
}
.ripple.r1 {
  left: 14%;
  top: 10rpx;
  animation-delay: 0s;
}
.ripple.r2 {
  left: 45%;
  top: 26rpx;
  animation-delay: 1.2s;
}
.ripple.r3 {
  left: 73%;
  top: 14rpx;
  animation-delay: 2.4s;
}
@keyframes ripple-grow {
  0% {
    transform: scale(0.3);
    opacity: 0.85;
  }
  70% {
    opacity: 0.25;
  }
  100% {
    transform: scale(2.2);
    opacity: 0;
  }
}
.sea .h-icon {
  position: absolute;
  left: 0;
  right: 0;
  top: 12rpx;
  text-align: center;
  z-index: 3;
}
@keyframes wave-rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}
@keyframes isle-float {
  0%,
  100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-12rpx);
  }
}

/* 搜索 */
.search-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 12rpx 12rpx 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(155, 140, 255, 0.12);
  margin-bottom: 28rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.search-btn {
  width: 52rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #f0ecff;
  color: #5a4d9b;
  font-size: 22rpx;
  font-weight: 600;
  text-align: center;
  letter-spacing: 0;
  flex-shrink: 0;
}

/* 用户卡片 */
.user-card,
.me-card {
  display: flex;
  align-items: center;
}
.u-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.u-avatar.big {
  font-size: 48rpx;
}
.u-info {
  flex: 1;
  margin-left: 24rpx;
}
.u-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d2a3a;
}
.add-btn {
  width: 190rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
}

/* 我的名片：编辑资料按钮 */
.edit-btn {
  flex-shrink: 0;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #f0ecff;
  color: #5a4d9b;
  font-size: 26rpx;
  font-weight: 500;
}

/* 编辑资料弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d2a3a;
  text-align: center;
  margin-bottom: 28rpx;
}
.modal-input {
  background: #f5f3fb;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.modal-btn.cancel {
  background: #f0edf8;
  color: #8a8597;
}
.modal-btn.ok {
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
}

/* 四宫格（均匀 2×2） */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0;
}
.g {
  position: relative;
  width: 50%;
  box-sizing: border-box;
  padding: 32rpx;
  min-height: 210rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  border-bottom: 2rpx solid #f0edf8;
}
.g:nth-child(odd) {
  border-right: 2rpx solid #f0edf8;
}
.g:nth-child(n + 3) {
  border-bottom: none;
}
/* 透明分享按钮覆盖整格，保证四格结构一致 */
.g-share {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  opacity: 0;
  z-index: 1;
  margin: 0;
  padding: 0;
  border-radius: 0;
}
.g-share::after {
  border: none;
}
.g-icon {
  font-size: 52rpx;
  margin-bottom: 14rpx;
}
.g-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d2a3a;
}
.g-desc {
  font-size: 24rpx;
  color: #8a8597;
  margin-top: 6rpx;
}

/* 好友列表 */
.f-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

/* 好友申请 */
.req {
  display: flex;
  align-items: center;
}
.req-actions {
  display: flex;
  gap: 14rpx;
}
.mini-btn {
  width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 0;
  padding: 0;
}
.mini-btn.ok {
  background: linear-gradient(135deg, #4fd1c5, #2bb5a6);
  color: #fff;
}
.mini-btn.no {
  background: #f0edf8;
  color: #8a8597;
}
.center {
  text-align: center;
  padding: 80rpx 0;
}
