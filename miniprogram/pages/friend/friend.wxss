/* 视图切换 */
.seg {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #8a8597;
  font-size: 28rpx;
  border: 2rpx solid #ece8f6;
}
.seg-item.active {
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-weight: 600;
  border: none;
}

/* 插画 */
.hero {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 30rpx 0 36rpx;
}
.h-island {
  font-size: 56rpx;
}
.h-icon {
  font-size: 40rpx;
}

/* 搜索 */
.search-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: #fff;
  border-radius: 999rpx;
  padding: 12rpx 12rpx 12rpx 32rpx;
  box-shadow: 0 10rpx 30rpx rgba(155, 140, 255, 0.12);
  margin-bottom: 28rpx;
}
.search-input {
  flex: 1;
  font-size: 28rpx;
}
.search-btn {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #f0ecff;
  color: #5a4d9b;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
}

/* 用户卡片 */
.user-card,
.me-card {
  display: flex;
  align-items: center;
}
.u-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.u-avatar.big {
  font-size: 48rpx;
}
.u-info {
  flex: 1;
  margin-left: 24rpx;
}
.u-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d2a3a;
}
.add-btn {
  width: 190rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  margin: 0;
  padding: 0;
}

/* 四宫格 */
.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 8rpx 0;
}
.g {
  width: 50%;
  box-sizing: border-box;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}
.g-btn {
  background: transparent;
  margin: 0;
  border-radius: 0;
  line-height: inherit;
  font-size: inherit;
  text-align: left;
}
.g-btn::after {
  border: none;
}
.g-icon {
  font-size: 52rpx;
  margin-bottom: 14rpx;
}
.g-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #2d2a3a;
}
.g-desc {
  font-size: 24rpx;
  color: #8a8597;
  margin-top: 6rpx;
}

/* 好友列表 */
.f-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

/* 好友申请 */
.req {
  display: flex;
  align-items: center;
}
.req-actions {
  display: flex;
  gap: 14rpx;
}
.mini-btn {
  width: 120rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  margin: 0;
  padding: 0;
}
.mini-btn.ok {
  background: linear-gradient(135deg, #4fd1c5, #2bb5a6);
  color: #fff;
}
.mini-btn.no {
  background: #f0edf8;
  color: #8a8597;
}
.center {
  text-align: center;
  padding: 80rpx 0;
}
