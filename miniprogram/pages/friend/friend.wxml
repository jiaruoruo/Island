<view class="page bg-gradient">
  <!-- 视图切换 -->
  <view class="seg">
    <view class="seg-item {{view === 'add' ? 'active' : ''}}" data-v="add" bindtap="switchView">添加好友</view>
    <view class="seg-item {{view === 'requests' ? 'active' : ''}}" data-v="requests" bindtap="switchView">好友申请</view>
  </view>

  <block wx:if="{{view === 'add'}}">
    <!-- 插画：两座小岛 + 中间海水动画 -->
    <view class="hero">
      <view class="sea">
        <view class="sea-line l1"></view>
        <view class="sea-line l2"></view>
        <view class="ripple r1"></view>
        <view class="ripple r2"></view>
        <view class="ripple r3"></view>
        <text class="fish fish1">🐟</text>
        <text class="fish fish2">🐠</text>
      </view>

      <view class="isle">
        <view class="scene">
          <view class="island"></view>
          <view class="palm">
            <view class="trunk"></view>
            <view class="coconut c1"></view>
            <view class="coconut c2"></view>
            <view class="coconut c3"></view>
            <view class="coconut c4"></view>
            <view class="coconut c5"></view>
            <view class="crown">
              <view class="frond f1"></view>
              <view class="frond f2"></view>
              <view class="frond f3"></view>
              <view class="frond f4"></view>
              <view class="frond f5"></view>
              <view class="frond f6"></view>
            </view>
          </view>
          <view class="octo-wrap">
            <octopus size="90" color="#FF7E9D"></octopus>
            <text class="telescope telescope-l">🔭</text>
          </view>
        </view>
      </view>

      <view class="isle isle-right">
        <view class="scene">
          <view class="island"></view>
          <view class="palm">
            <view class="trunk"></view>
            <view class="coconut c1"></view>
            <view class="coconut c2"></view>
            <view class="coconut c3"></view>
            <view class="coconut c4"></view>
            <view class="coconut c5"></view>
            <view class="crown">
              <view class="frond f1"></view>
              <view class="frond f2"></view>
              <view class="frond f3"></view>
              <view class="frond f4"></view>
              <view class="frond f5"></view>
              <view class="frond f6"></view>
            </view>
          </view>
          <view class="octo-wrap">
            <octopus size="90" color="#4FD1C5"></octopus>
            <text class="telescope telescope-r">🔭</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 搜索 -->
    <view class="search-card">
      <text class="search-icon">🔍</text>
      <input class="search-input" placeholder="搜索 Island号或手机号" value="{{q}}" bindinput="onQ" confirm-type="search" bindconfirm="search" />
      <view class="search-btn" bindtap="search">搜索</view>
    </view>

    <!-- 搜索结果 -->
    <view class="card user-card" wx:if="{{result}}">
      <view class="u-avatar">{{result.nickname[0]}}</view>
      <view class="u-info">
        <view class="u-name">{{result.nickname}}</view>
        <view class="muted">Island号 {{result.uid}}</view>
      </view>
      <button class="add-btn" data-id="{{result.id}}" bindtap="sendRequest">＋ 加好友</button>
    </view>

    <!-- 我的名片 -->
    <view class="card me-card" wx:if="{{me}}">
      <view class="u-avatar big">🐙</view>
      <view class="u-info">
        <view class="u-name">{{me.nickname}}</view>
        <view class="muted">Island号 {{me.uid}}</view>
      </view>
      <view class="edit-btn" catchtap="openEdit">✏️ 编辑资料</view>
    </view>

    <!-- 四宫格动作（均匀 2×2） -->
    <view class="card grid">
      <view class="gline gline-h"></view>
      <view class="gline gline-vt"></view>
      <view class="gline gline-vb"></view>
      <view class="g">
        <button class="g-share" open-type="share"></button>
        <view class="g-icon wx-icon"></view>
        <view class="g-title">邀请微信好友</view>
        <view class="g-desc">邀请好友加入 Island</view>
        <text class="g-arrow">›</text>
      </view>
      <view class="g" bindtap="copyLink">
        <view class="g-icon">🔗</view>
        <view class="g-title">复制邀请码</view>
        <view class="g-desc">分享到微信或其他平台</view>
        <text class="g-arrow">›</text>
      </view>
      <view class="g" bindtap="myQr">
        <view class="g-icon">📱</view>
        <view class="g-title">我的二维码</view>
        <view class="g-desc">让朋友扫码加我</view>
        <text class="g-arrow">›</text>
      </view>
      <view class="g" bindtap="scan">
        <view class="g-icon">📷</view>
        <view class="g-title">扫一扫</view>
        <view class="g-desc">扫描朋友的 Island号</view>
        <text class="g-arrow">›</text>
      </view>
    </view>

    <!-- 我的好友 -->
    <view class="card" wx:if="{{friends.length}}">
      <view class="subtitle">我的好友</view>
      <view class="f-row" wx:for="{{friends}}" wx:key="id">
        <view class="u-avatar">{{item.nickname[0]}}</view>
        <view class="u-info">
          <view class="u-name">{{item.nickname}}</view>
          <view class="muted">Island号 {{item.uid}}</view>
        </view>
      </view>
    </view>
  </block>

  <block wx:if="{{view === 'requests'}}">
    <view class="card req" wx:for="{{requests}}" wx:key="id">
      <view class="u-avatar" wx:if="{{item.fromUser}}">{{item.fromUser.nickname[0]}}</view>
      <view class="u-info">
        <view class="u-name">{{item.fromUser.nickname}}</view>
        <view class="muted">Island号 {{item.fromUser.uid}}</view>
      </view>
      <view class="req-actions">
        <button class="mini-btn ok" data-id="{{item.id}}" bindtap="accept">通过</button>
        <button class="mini-btn no" data-id="{{item.id}}" bindtap="reject">拒绝</button>
      </view>
    </view>
    <view wx:if="{{!requests.length}}" class="muted center">暂无好友申请</view>
  </block>

  <!-- 编辑资料弹窗 -->
  <view class="modal-mask" wx:if="{{showEdit}}" catchtap="cancelEdit">
    <view class="modal" catchtap="noop">
      <view class="modal-title">编辑资料</view>
      <input class="modal-input" placeholder="请输入昵称" value="{{editNickname}}" bindinput="onEditNick" maxlength="20" />
      <view class="modal-actions">
        <view class="modal-btn cancel" catchtap="cancelEdit">取消</view>
        <view class="modal-btn ok" catchtap="saveEdit">保存</view>
      </view>
    </view>
  </view>
</view>
