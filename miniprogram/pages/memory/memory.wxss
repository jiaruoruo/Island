.top {
  padding: 16rpx 0 24rpx;
}
.search-row {
  display: flex;
  gap: 16rpx;
  align-items: center;
  margin-bottom: 24rpx;
}
.input {
  flex: 1;
  background: #fff;
  border-radius: 40rpx;
  padding: 18rpx 28rpx;
  font-size: 28rpx;
}
.search-btn {
  width: 150rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 28rpx;
}
.mem-card {
  position: relative;
}
.mem-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.del {
  color: #ff3b30;
  font-size: 26rpx;
}
.mem-value {
  margin-top: 16rpx;
  font-size: 30rpx;
  font-weight: 500;
}
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 30rpx rgba(255, 126, 157, 0.4);
  z-index: 5;
}
.center {
  text-align: center;
  padding: 80rpx 0;
}
.mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(45, 42, 58, 0.4);
  z-index: 10;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 40rpx 32rpx 60rpx;
  z-index: 11;
}
.type-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0;
}
.type {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}
