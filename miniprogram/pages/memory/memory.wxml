<view class="page bg-gradient">
  <view class="top">
    <view class="title">共享记忆</view>
    <view class="muted">纪念日 · 心愿 · 约定 · 喜好，都替你们记着</view>
  </view>

  <view class="search-row">
    <input class="input" placeholder="搜一搜，比如「想吃的那家店」" value="{{query}}" bindinput="onQuery" />
    <button class="btn btn-ghost search-btn" bindtap="search">检索</button>
  </view>

  <view class="fab" bindtap="openAdd">＋</view>

  <view wx:for="{{memories}}" wx:key="id" class="card mem-card">
    <view class="mem-head">
      <view class="chip" style="background:{{item.chipBg}};color:{{item.typeColor}};">{{item.typeLabel}}</view>
      <view class="del" data-id="{{item.id}}" bindtap="remove">删除</view>
    </view>
    <view class="mem-value">{{item.value}}</view>
  </view>

  <view wx:if="{{memories.length === 0}}" class="muted center">还没有记忆，去聊天里让小章鱼记住点什么吧</view>

  <!-- 新增记忆弹窗 -->
  <view class="mask" wx:if="{{showAdd}}" bindtap="closeAdd"></view>
  <view class="sheet" wx:if="{{showAdd}}">
    <view class="subtitle">新增记忆</view>
    <view class="type-row">
      <view wx:for="{{TYPES}}" wx:key="key" class="type {{type === item.key ? 'active' : ''}}" data-t="{{item.key}}" bindtap="chooseType" style="color:{{type === item.key ? '#fff' : item.color}};background:{{type === item.key ? item.color : '#f6f4ff'}};">{{item.label}}</view>
    </view>
    <input class="input" placeholder="记点什么…" value="{{value}}" bindinput="onValue" />
    <button class="btn" bindtap="add">保存</button>
  </view>
</view>
