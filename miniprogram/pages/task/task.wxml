<view class="page bg-gradient">
  <view class="top">
    <view class="title">共同任务</view>
    <view class="muted">和 TA 一起完成的小目标</view>
  </view>

  <view class="add-row">
    <input class="input" placeholder="添加任务，比如「周末一起看电影」" value="{{input}}" bindinput="onInput" confirm-type="done" bindconfirm="add" />
    <button class="add-btn" bindtap="add">添加</button>
  </view>

  <view wx:for="{{tasks}}" wx:key="id" class="card task {{item.done ? 'done' : ''}}">
    <view class="task-check {{item.done ? 'checked' : ''}}" data-id="{{item.id}}" bindtap="toggle">{{item.done ? '✓' : ''}}</view>
    <view class="task-text">{{item.text}}</view>
    <view class="task-del" data-id="{{item.id}}" bindtap="remove">✕</view>
  </view>

  <view wx:if="{{tasks.length === 0}}" class="muted center">还没有任务，一起立个小目标吧</view>
</view>
