.top {
  padding: 16rpx 0 24rpx;
}
.add-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
}
.input {
  flex: 1;
  background: #fff;
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}
.add-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #4fd1c5, #2bb5a6);
  color: #fff;
  font-size: 28rpx;
  margin: 0;
}
.task {
  display: flex;
  align-items: center;
}
.task.done .task-text {
  text-decoration: line-through;
  color: #b0a9c8;
}
.task-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 3rpx solid #d8d3ea;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  flex-shrink: 0;
  transition: all 0.2s ease;
}
.task-check.checked {
  background: linear-gradient(135deg, #4fd1c5, #2bb5a6);
  border-color: transparent;
}
.task-text {
  flex: 1;
  margin: 0 20rpx;
  font-size: 28rpx;
  word-break: break-all;
}
.task-del {
  color: #c8c2e0;
  padding: 8rpx;
  font-size: 30rpx;
}
.center {
  text-align: center;
  padding: 80rpx 0;
}
