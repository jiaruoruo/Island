.top {
  padding: 16rpx 0 24rpx;
}
.plan-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx;
}
.plan-badge {
  padding: 8rpx 32rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
}
.price {
  margin-top: 20rpx;
  font-size: 72rpx;
  font-weight: 700;
  color: #2d2a3a;
}
.price .muted {
  font-size: 26rpx;
  font-weight: 400;
}
.benefit {
  padding: 14rpx 0;
  color: #5a4d9b;
  font-size: 28rpx;
}
.note {
  margin-top: 24rpx;
}
