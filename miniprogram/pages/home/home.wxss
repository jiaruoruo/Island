.top {
  padding: 16rpx 0 24rpx;
}
.scene {
  position: relative;
  height: 360rpx;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(155, 140, 255, 0.15);
}
.decor-grid {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  z-index: 2;
}
.decor-item {
  font-size: 56rpx;
}
.floor {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: rgba(255, 255, 255, 0.4);
  border-radius: 50% 50% 0 0;
}
.scenes {
  display: flex;
  gap: 24rpx;
  margin-top: 20rpx;
}
.scene-opt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.scene-swatch {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  border: 4rpx solid transparent;
}
.scene-opt.active .scene-swatch {
  border-color: #9b8cff;
  box-shadow: 0 0 0 6rpx rgba(155, 140, 255, 0.3);
}
.decor-opts {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}
.decor-opt {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  border-radius: 24rpx;
  background: #f6f4ff;
  border: 3rpx solid transparent;
}
.decor-opt.active {
  border-color: #9b8cff;
  background: #fff;
}
