.welcome {
  display: flex;
  flex-direction: column;
}
.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
}
.brand {
  margin-top: 40rpx;
  text-align: center;
}
.slogan {
  margin-top: 16rpx;
  text-align: center;
}
.agree {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}
.agree-card {
  display: flex;
  justify-content: center;
  margin-top: 36rpx;
  padding: 0 8rpx;
}

/* 登录方式切换 */
.mode-tabs {
  display: flex;
  gap: 16rpx;
  margin: 24rpx 0;
}
.mode {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 24rpx;
  background: #f6f4ff;
  color: #8a8597;
  font-size: 28rpx;
}
.mode.active {
  background: #fff;
  color: #5a4d9b;
  font-weight: 600;
  box-shadow: 0 8rpx 20rpx rgba(155, 140, 255, 0.15);
}

/* 微信登录按钮 */
.btn-wechat {
  background: #07c160;
  box-shadow: 0 10rpx 30rpx rgba(7, 193, 96, 0.3);
}

/* 手机号登录 */
.phone-card {
  padding: 32rpx;
}
.field-label {
  font-size: 26rpx;
  color: #5a4d9b;
  font-weight: 500;
  margin: 16rpx 0 12rpx;
}
.ph {
  color: #c3bed6;
}
.input {
  background: #f6f4ff;
  border-radius: 20rpx;
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  border: 2rpx solid transparent;
}
.code-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.code-input {
  flex: 1;
}
.code-btn {
  width: 230rpx;
  height: 80rpx;
  line-height: 76rpx;
  padding: 0;
  border-radius: 20rpx;
  background: #f6f4ff;
  color: #5a4d9b;
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx solid #e6e0ff;
  margin: 0;
}
.code-btn[disabled] {
  color: #b9b3cc;
  background: #f0edf8;
  border-color: #ece8f6;
}
.dev-hint {
  font-size: 24rpx;
  color: #b0a9c8;
  margin: 4rpx 0 20rpx;
}
