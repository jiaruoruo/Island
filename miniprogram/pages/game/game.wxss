.top {
  padding: 16rpx 0 24rpx;
}
.game-grid {
  display: flex;
  gap: 24rpx;
}
.game-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx;
}
.game-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.result {
  margin-top: 40rpx;
}
.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}
.result-text {
  font-size: 34rpx;
  font-weight: 600;
  text-align: center;
  line-height: 1.6;
}
.center {
  text-align: center;
  padding: 60rpx 0;
}
