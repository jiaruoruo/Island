.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
}
.status-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
  padding: 20rpx 24rpx;
}
.mini-octo {
  width: 96rpx;
  height: 96rpx;
}
.status-info {
  margin-left: 20rpx;
}
.msg-scroll {
  flex: 1;
  overflow: hidden;
  padding: 8rpx 4rpx;
}
.spacer {
  height: 24rpx;
}
.actions-bar {
  white-space: nowrap;
  padding: 12rpx 0;
}
.act {
  display: inline-block;
  padding: 14rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.9);
  color: #5a4d9b;
  font-size: 26rpx;
  box-shadow: 0 6rpx 18rpx rgba(155, 140, 255, 0.12);
}
.input-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding-top: 12rpx;
}
.input {
  flex: 1;
  background: #fff;
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.04);
}
.send-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 28rpx;
  margin: 0;
}
