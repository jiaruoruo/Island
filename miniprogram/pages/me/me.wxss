/* 头像卡片 */
.profile-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx 40rpx;
  margin-bottom: 24rpx;
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(10px);
  border-radius: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(155, 140, 255, 0.12);
}
.p-name {
  margin-top: 20rpx;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--text);
}
.p-uid {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: var(--muted);
}
.edit-btn {
  margin-top: 24rpx;
  padding: 10rpx 30rpx;
  border: 2rpx solid #2d2a3a;
  border-radius: 24rpx;
  background: #fff;
  color: #2d2a3a;
  font-size: 26rpx;
  font-weight: 500;
}

/* 统计 */
.stats {
  display: flex;
  align-items: center;
}
.stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--text);
}
.stat-label {
  margin-top: 4rpx;
  font-size: 26rpx;
  color: var(--muted);
}
.stat-divider {
  width: 2rpx;
  height: 56rpx;
  background: #ece8f6;
}

/* 退出按钮 */
.btn-logout {
  margin-top: 8rpx;
  background: rgba(255, 255, 255, 0.8);
  color: #ff5f78;
  border: 2rpx solid #ffd7df;
  box-shadow: none;
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.45);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.modal {
  width: 560rpx;
  background: #fff;
  border-radius: 28rpx;
  padding: 40rpx 36rpx 32rpx;
}
.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #2d2a3a;
  text-align: center;
  margin-bottom: 28rpx;
}
.modal-input {
  background: #f5f3fb;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  font-size: 30rpx;
  margin-bottom: 32rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.modal-btn.cancel {
  background: #f0edf8;
  color: #8a8597;
}
.modal-btn.ok {
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
}
