.octo {
  position: relative;
  display: inline-block;
}

/* 头部 */
.head {
  position: absolute;
  top: 8%;
  left: 50%;
  transform: translateX(-50%);
  width: 62%;
  height: 58%;
  border-radius: 50%;
  box-shadow: inset -10rpx -12rpx 30rpx rgba(0, 0, 0, 0.08);
}

/* 眼睛（带眨眼动画） */
.eye {
  position: absolute;
  top: 34%;
  width: 14%;
  height: 14%;
  background: #2d2a3a;
  border-radius: 50%;
}
.eye-l { left: 26%; }
.eye-r { right: 26%; }
.eye::after {
  content: '';
  position: absolute;
  top: 18%;
  left: 18%;
  width: 36%;
  height: 36%;
  background: #fff;
  border-radius: 50%;
}
@keyframes blink {
  0%, 92%, 100% { transform: scaleY(1); }
  96% { transform: scaleY(0.1); }
}
.eye { animation: blink 4s infinite; }

/* 腮红 */
.blush {
  position: absolute;
  top: 52%;
  width: 12%;
  height: 7%;
  background: rgba(255, 255, 255, 0.45);
  border-radius: 50%;
}
.blush-l { left: 20%; }
.blush-r { right: 20%; }

/* 微笑 */
.mouth {
  position: absolute;
  top: 56%;
  left: 50%;
  transform: translateX(-50%);
  width: 22%;
  height: 12%;
  border-bottom: 4rpx solid #2d2a3a;
  border-radius: 0 0 50% 50%;
}

/* 触手 */
.tentacles {
  position: absolute;
  bottom: 4%;
  left: 50%;
  transform: translateX(-50%);
  width: 80%;
  height: 40%;
}
.tent {
  position: absolute;
  bottom: 0;
  width: 16%;
  height: 70%;
  border-radius: 999rpx;
  opacity: 0.9;
  transform-origin: bottom center;
}
.t1 { left: 4%; animation: sway 2.6s ease-in-out infinite; }
.t2 { left: 28%; animation: sway 2.2s ease-in-out infinite reverse; }
.t3 { right: 28%; animation: sway 2.4s ease-in-out infinite; }
.t4 { right: 4%; animation: sway 2.0s ease-in-out infinite reverse; }
@keyframes sway {
  0%, 100% { transform: rotate(-6deg); }
  50% { transform: rotate(6deg); }
}

/* 配饰 */
.acc {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
}
.bow {
  top: -2%;
  width: 34%;
  height: 22%;
  background: #9b8cff;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  clip-path: polygon(0 45%, 45% 45%, 45% 0, 55% 0, 55% 45%, 100% 45%, 100% 70%, 55% 70%, 55% 100%, 45% 100%, 45% 70%, 0 70%);
}
.hat {
  top: -16%;
  width: 40%;
  height: 20%;
  background: #4fd1c5;
  border-radius: 8rpx;
}
.hat::after {
  content: '';
  position: absolute;
  bottom: -30%;
  left: 0;
  width: 100%;
  height: 34%;
  background: #4fd1c5;
  border-radius: 999rpx;
}
.crown {
  top: -10%;
  width: 40%;
  height: 20%;
  background: #ff9500;
  clip-path: polygon(0 100%, 0 0, 20% 50%, 40% 0, 60% 50%, 80% 0, 100% 0, 100% 100%);
}
