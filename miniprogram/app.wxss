/* 全局主题：治愈系萌宠 · 柔和渐变 · 玻璃质感 */
page {
  --pink: #ff7e9d;
  --mint: #4fd1c5;
  --purple: #9b8cff;
  --bg: #fff5f7;
  --card: #ffffff;
  --text: #2d2a3a;
  --muted: #8a8597;
  --green: #34c759;
  --red: #ff3b30;
  --orange: #ff9500;
  --blue: #4fa3ff;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.page {
  min-height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 柔和渐变背景 */
.bg-gradient {
  background: linear-gradient(160deg, #fff5f7 0%, #f3f0ff 55%, #eafaf7 100%);
}

/* 玻璃质感卡片 */
.card {
  background: rgba(255, 255, 255, 0.86);
  backdrop-filter: blur(10px);
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 12rpx 40rpx rgba(155, 140, 255, 0.12);
  margin-bottom: 24rpx;
}

/* 主按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #ff7e9d, #9b8cff);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 30rpx rgba(255, 126, 157, 0.35);
  transition: transform 0.1s ease;
}
.btn:active {
  transform: scale(0.97);
}
.btn-ghost {
  background: rgba(255, 255, 255, 0.8);
  color: var(--purple);
  border: 2rpx solid #e6e0ff;
  box-shadow: none;
}
.btn-mint {
  background: linear-gradient(135deg, #4fd1c5, #2bb5a6);
  box-shadow: 0 10rpx 30rpx rgba(79, 209, 197, 0.35);
}

.title {
  font-size: 40rpx;
  font-weight: 600;
  color: var(--text);
}
.subtitle {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--text);
}
.muted {
  color: var(--muted);
  font-size: 26rpx;
}

/* 圆角标签 */
.chip {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: #f3f0ff;
  color: var(--purple);
  font-size: 24rpx;
  margin: 6rpx;
}

/* 微动效：呼吸/漂浮 */
@keyframes floaty {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}
.float {
  animation: floaty 3s ease-in-out infinite;
}

@keyframes pop {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}
.pop {
  animation: pop 0.35s ease;
}

.section-gap {
  height: 24rpx;
}
