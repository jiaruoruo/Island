# ===== 服务 =====
PORT=3000

# ===== 数据存储 =====
# memory = 内存存储（零依赖，开箱即跑，适合本地验证）
# prisma = PostgreSQL（需先 docker compose up -d 并 prisma migrate）
STORE=memory
DATABASE_URL=postgresql://twoo:twoo@localhost:5432/twoo?schema=public

# ===== AI 大模型（OpenAI 兼容端点，可接豆包/混元/通义/Kimi）=====
# true = 内置 Mock（无密钥也能端到端跑通对话与记忆闭环）
MOCK_AI=true
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBED_MODEL=text-embedding-3-small

# ===== 微信登录（MVP 默认 Mock）=====
MOCK_AUTH=true
WX_APPID=
WX_SECRET=

# ===== 微信支付（MVP 默认 Mock，真实接入需商户号）=====
MOCK_PAY=true

# ===== 合规 =====
# 真实实名核验 / 文本审核接口位（MVP 用 Mock + 基础敏感词过滤）
REAL_ID_VERIFY=false
TEXT_MODERATE_API=
